{
  "name": "deletedata",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Outil personnel et local de suppression de données data brokers (RGPD art. 17) avec preuve de suppression.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "cli": "tsx src/cli/index.ts",
    "doctor": "tsx src/cli/index.ts doctor",
    "dashboard": "npm run build --prefix web && tsx src/cli/index.ts serve",
    "test-connections": "tsx scripts/test-connections.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@google/genai": "^2.10.0",
    "better-sqlite3": "npm:better-sqlite3-multiple-ciphers@^12.11.1",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "imapflow": "^1.4.2",
    "mailparser": "^3.9.11",
    "node-cron": "^4.5.0",
    "nodemailer": "^9.0.1",
    "playwright": "^1.61.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
