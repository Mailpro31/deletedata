# ============================================================================
#  deletedata — fichier d'exemple. Copier en `.env` et remplir.
#  Le `.env` est git-ignoré : NE JAMAIS committer de vrais secrets.
# ============================================================================

# ----------------------------------------------------------------------------
#  SÉCURITÉ / GARDE-FOUS D'ENVOI
# ----------------------------------------------------------------------------
# DRY_RUN=true  -> génère et logue les emails SANS rien envoyer (défaut, sûr).
# Pour ENVOYER POUR DE VRAI il faut LES DEUX :
#   1) DRY_RUN=false
#   2) LIVE_CONFIRM=I_UNDERSTAND
# Tant que ces deux conditions ne sont pas réunies, aucun email ne part.
DRY_RUN=true
LIVE_CONFIRM=

# ----------------------------------------------------------------------------
#  BASE DE DONNÉES CHIFFRÉE (SQLCipher via better-sqlite3-multiple-ciphers)
# ----------------------------------------------------------------------------
DB_PATH=./data/deletedata.db
# Passphrase qui déchiffre toute la base. Choisis-en une longue et unique.
# ATTENTION : si tu la perds, les données sont irrécupérables.
# Stockée en variable d'env -> protège contre le vol du fichier/disque,
# PAS contre quelqu'un qui a déjà accès à cet environnement.
DB_PASSPHRASE=

# ----------------------------------------------------------------------------
#  ENVOI EMAIL (SMTP) — Gmail + App Password par défaut
# ----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=monemail@gmail.com
# App password Gmail (16 caractères), PAS ton vrai mot de passe.
SMTP_PASS=
# Nom affiché dans le From (optionnel)
MAIL_FROM_NAME=
# Adresse de base pour le plus-addressing (défaut = SMTP_USER).
# Les alias seront de la forme local+broker-slug@domaine.
MAIL_BASE_ADDRESS=

# ----------------------------------------------------------------------------
#  RÉCEPTION / VÉRIFICATION (IMAP) — Gmail par défaut
# ----------------------------------------------------------------------------
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=monemail@gmail.com
# App password Gmail (peut être le même que SMTP_PASS).
IMAP_PASS=
IMAP_MAILBOX=INBOX

# ----------------------------------------------------------------------------
#  CLASSIFICATION LLM — VERTEX AI (Google Cloud), PAS AI Studio
# ----------------------------------------------------------------------------
# Projet Google Cloud dédié (ne pas mélanger avec un projet AI Studio).
GOOGLE_CLOUD_PROJECT=
# Région EU pour la résidence des données (ex: europe-west1, europe-west4).
GOOGLE_CLOUD_LOCATION=europe-west1
# Modèle Gemini Flash (GA). gemini-2.0-flash est en fin de vie.
VERTEX_MODEL=gemini-2.5-flash
# Chemin vers la clé JSON du service account (Application Default Credentials).
# Alternative en dev local: `gcloud auth application-default login`.
GOOGLE_APPLICATION_CREDENTIALS=

# ----------------------------------------------------------------------------
#  DIVERS
# ----------------------------------------------------------------------------
# Niveau de log: debug | info | warn | error
LOG_LEVEL=info
# Délai (jours) avant de re-cibler un broker non confirmé (anti-spam).
RETARGET_DAYS=90
